{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "xftun",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": false,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": "bootstrap-dns"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "proxy-dns",
    "rule_set": [
      {
        "type": "local",
        "tag": "geosite-ru-blocked",
        "format": "binary",
        "path": "rule-set/geosite-ru-blocked.srs"
      },
      {
        "type": "local",
        "tag": "geoip-ru-blocked",
        "format": "binary",
        "path": "rule-set/geoip-ru-blocked.srs"
      },
      {
        "type": "local",
        "tag": "geosite-category-ru",
        "format": "binary",
        "path": "rule-set/geosite-category-ru.srs"
      },
      {
        "type": "local",
        "tag": "geoip-ru",
        "format": "binary",
        "path": "rule-set/geoip-ru.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
