+
+// dialParallelRemembered races the families like upstream (IPv6 first when the
+// resolver put it first) and, for a name resolved IPv6-first, starts on the
+// family that last worked for it and remembers the winner (common/familymemory).
+func (h *Outbound) dialParallelRemembered(ctx context.Context, network string, destination M.Socksaddr, destinationAddresses []netip.Addr, networkStrategy *C.NetworkStrategy, networkType []C.InterfaceType, fallbackNetworkType []C.InterfaceType, fallbackDelay time.Duration) (net.Conn, error) {
+	preferIPv6 := len(destinationAddresses) > 0 && destinationAddresses[0].Is6()
+	remembered := preferIPv6 && destination.IsDomain()
+	if remembered {
+		preferIPv6 = familymemory.Default.PreferIPv6(destination.Fqdn, true)
+	}
+	conn, err := dialer.DialParallelNetwork(ctx, h.dialer, network, destination, destinationAddresses, preferIPv6, networkStrategy, networkType, fallbackNetworkType, fallbackDelay)
+	if err == nil && remembered {
+		dialer.RememberSucceeded(destination.Fqdn, conn)
+	}
+	return conn, err
