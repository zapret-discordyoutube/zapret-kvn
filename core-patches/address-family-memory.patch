diff --git a/common/dialer/zapret_family_test.go b/common/dialer/zapret_family_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ee8f37070c3de78f052685068914c4bebe0abe24
--- /dev/null
+++ b/common/dialer/zapret_family_test.go
@@ -0,0 +1,100 @@
+package dialer
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/familymemory"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// familyStubDialer refuses one family at once (like a server whose IPv6
+// answers with RST) and connects the other over an in-memory pipe.
+type familyStubDialer struct {
+	refuse6 bool
+	access  sync.Mutex
+	dialed  []netip.Addr
+}
+
+type remoteConn struct {
+	net.Conn
+	remote net.Addr
+}
+
+func (c remoteConn) RemoteAddr() net.Addr { return c.remote }
+
+func (d *familyStubDialer) DialContext(_ context.Context, _ string, destination M.Socksaddr) (net.Conn, error) {
+	d.access.Lock()
+	d.dialed = append(d.dialed, destination.Addr)
+	d.access.Unlock()
+	if destination.Addr.Is6() == d.refuse6 {
+		return nil, syscall.ECONNREFUSED
+	}
+	client, server := net.Pipe()
+	go server.Close()
+	return remoteConn{Conn: client, remote: destination.TCPAddr()}, nil
+}
+
+func (d *familyStubDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	return nil, syscall.EAFNOSUPPORT
+}
+
+func (d *familyStubDialer) first() netip.Addr {
+	d.access.Lock()
+	defer d.access.Unlock()
+	return d.dialed[0]
+}
+
+func TestRememberedRaceStartsOnTheFamilyThatWorked(t *testing.T) {
+	familymemory.Default.Reset()
+	t.Cleanup(familymemory.Default.Reset)
+	v4, v6 := netip.MustParseAddr("192.0.2.20"), netip.MustParseAddr("2001:db8::20")
+	destination := M.ParseSocksaddrHostPort("race.example", 443)
+
+	refusing := &familyStubDialer{refuse6: true}
+	conn, err := dialRemembered(context.Background(), refusing, "tcp", destination, []netip.Addr{v4, v6}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	if refusing.first() != v6 {
+		t.Fatalf("an unknown server must be tried on IPv6 first, dialed %v", refusing.dialed)
+	}
+	if familymemory.Default.PreferIPv6("race.example", true) {
+		t.Fatal("IPv4 won the race, it must be remembered")
+	}
+
+	next := &familyStubDialer{refuse6: true}
+	conn, err = dialRemembered(context.Background(), next, "tcp", destination, []netip.Addr{v4, v6}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn.Close()
+	if next.first() != v4 {
+		t.Fatalf("the next connection must start on the remembered IPv4, dialed %v", next.dialed)
+	}
+}
+
+func TestRememberedRaceUsesIPv6WhenIPv4IsBlocked(t *testing.T) {
+	familymemory.Default.Reset()
+	t.Cleanup(familymemory.Default.Reset)
+	v4, v6 := netip.MustParseAddr("192.0.2.21"), netip.MustParseAddr("2001:db8::21")
+	destination := M.ParseSocksaddrHostPort("blocked4.example", 443)
+	blocked4 := &familyStubDialer{refuse6: false}
+	conn, err := dialRemembered(context.Background(), blocked4, "tcp", destination, []netip.Addr{v4, v6}, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := M.SocksaddrFromNet(conn.RemoteAddr()).Addr; got != v6 {
+		t.Fatalf("IPv6 must carry the connection, got %s", got)
+	}
+	conn.Close()
+	if !familymemory.Default.PreferIPv6("blocked4.example", false) {
+		t.Fatal("IPv6 won, it must be remembered")
+	}
+}
diff --git a/common/familymemory/memory.go b/common/familymemory/memory.go
new file mode 100644
index 0000000000000000000000000000000000000000..d727db1ed0e3aa3b48645c2c5ed7905f277e1eed
--- /dev/null
+++ b/common/familymemory/memory.go
@@ -0,0 +1,209 @@
+// Package familymemory remembers, per VPN server name, which IP address
+// family last carried a working connection and which one last failed.
+//
+// Zapret KVN prefers IPv6 for the outer connection to a VPN server (an IPv4
+// address is often blocked by address while the IPv6 one is not). The race
+// itself belongs to the existing dialers: sing-box's DialParallel for TCP and
+// the official Hysteria client's own reconnect for QUIC. This package only
+// decides the order, so a family that just failed is not tried first again on
+// every new connection, and an IPv6 path that never answers costs its delay
+// once per TTL instead of once per connection.
+//
+// The memory is in-process only, keyed by the server name the dialer
+// resolved, and is forgotten on a network change (Reset) or after TTL.
+package familymemory
+
+import (
+	"context"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+// DefaultTTL is how long a remembered outcome steers the order.
+const DefaultTTL = 30 * time.Minute
+
+const maxEntries = 256
+
+type family uint8
+
+const (
+	familyNone family = 0
+	family4    family = 4
+	family6    family = 6
+)
+
+func familyOf(address netip.Addr) family {
+	address = address.Unmap()
+	switch {
+	case address.Is4():
+		return family4
+	case address.Is6():
+		return family6
+	default:
+		return familyNone
+	}
+}
+
+type entry struct {
+	worked family
+	failed family
+	at     time.Time
+}
+
+// Memory is safe for concurrent use.
+type Memory struct {
+	access  sync.Mutex
+	ttl     time.Duration
+	now     func() time.Time
+	entries map[string]entry
+}
+
+// New returns an empty memory. now may be nil (time.Now).
+func New(ttl time.Duration, now func() time.Time) *Memory {
+	if now == nil {
+		now = time.Now
+	}
+	return &Memory{ttl: ttl, now: now, entries: make(map[string]entry)}
+}
+
+// Default is the process-wide memory used by the protected server dialers.
+var Default = New(DefaultTTL, nil)
+
+func (m *Memory) fresh(name string) (entry, bool) {
+	current, loaded := m.entries[name]
+	if !loaded {
+		return entry{}, false
+	}
+	if m.now().Sub(current.at) > m.ttl {
+		delete(m.entries, name)
+		return entry{}, false
+	}
+	return current, true
+}
+
+func (m *Memory) store(name string, value entry) {
+	if _, loaded := m.entries[name]; !loaded && len(m.entries) >= maxEntries {
+		var oldestName string
+		var oldest time.Time
+		for key, item := range m.entries {
+			if oldestName == "" || item.at.Before(oldest) {
+				oldestName, oldest = key, item.at
+			}
+		}
+		delete(m.entries, oldestName)
+	}
+	value.at = m.now()
+	m.entries[name] = value
+}
+
+// PreferIPv6 tells a racing dialer which family to start first for name.
+// preferIPv6 is the resolver's own preference; it is returned unchanged when
+// nothing fresh is remembered.
+func (m *Memory) PreferIPv6(name string, preferIPv6 bool) bool {
+	m.access.Lock()
+	defer m.access.Unlock()
+	current, loaded := m.fresh(name)
+	if !loaded {
+		return preferIPv6
+	}
+	switch {
+	case current.worked != familyNone:
+		return current.worked == family6
+	case current.failed == family6:
+		return false
+	case current.failed == family4:
+		return true
+	default:
+		return preferIPv6
+	}
+}
+
+// Order returns addresses with the family to try first in front, keeping the
+// resolver's order inside each family. The input slice is not modified.
+func (m *Memory) Order(name string, addresses []netip.Addr, preferIPv6 bool) []netip.Addr {
+	return orderFamilies(addresses, m.PreferIPv6(name, preferIPv6))
+}
+
+// OrderPacket orders the addresses of a UDP socket that is opened once, with
+// no race. A caller that reports outcomes (WithOutcomeReports) follows Order,
+// so a failed family is replaced on its next connect. A caller that does not
+// report has no way back from a dead family, so it keeps IPv4 first unless
+// this name has already worked over IPv6.
+func (m *Memory) OrderPacket(ctx context.Context, name string, addresses []netip.Addr, preferIPv6 bool) []netip.Addr {
+	if ReportsOutcome(ctx) {
+		return m.Order(name, addresses, preferIPv6)
+	}
+	m.access.Lock()
+	current, loaded := m.fresh(name)
+	m.access.Unlock()
+	return orderFamilies(addresses, loaded && current.worked == family6)
+}
+
+// Succeeded records that a connection to address carried traffic.
+func (m *Memory) Succeeded(name string, address netip.Addr) {
+	value := familyOf(address)
+	if name == "" || value == familyNone {
+		return
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	m.store(name, entry{worked: value})
+}
+
+// Failed records that a connection to address did not complete.
+func (m *Memory) Failed(name string, address netip.Addr) {
+	value := familyOf(address)
+	if name == "" || value == familyNone {
+		return
+	}
+	m.access.Lock()
+	defer m.access.Unlock()
+	current, _ := m.fresh(name)
+	if current.worked == value {
+		current.worked = familyNone
+	}
+	current.failed = value
+	m.store(name, current)
+}
+
+// Reset forgets every outcome; called when the underlying network changes.
+func (m *Memory) Reset() {
+	m.access.Lock()
+	defer m.access.Unlock()
+	clear(m.entries)
+}
+
+func orderFamilies(addresses []netip.Addr, ipv6First bool) []netip.Addr {
+	ordered := make([]netip.Addr, 0, len(addresses))
+	first, second := family4, family6
+	if ipv6First {
+		first, second = family6, family4
+	}
+	for _, wanted := range []family{first, second} {
+		for _, address := range addresses {
+			if familyOf(address) == wanted {
+				ordered = append(ordered, address)
+			}
+		}
+	}
+	for _, address := range addresses {
+		if familyOf(address) == familyNone {
+			ordered = append(ordered, address)
+		}
+	}
+	return ordered
+}
+
+type outcomeReportsKey struct{}
+
+// WithOutcomeReports marks a dial whose caller calls Succeeded/Failed itself.
+func WithOutcomeReports(ctx context.Context) context.Context {
+	return context.WithValue(ctx, outcomeReportsKey{}, true)
+}
+
+// ReportsOutcome reports whether ctx was marked by WithOutcomeReports.
+func ReportsOutcome(ctx context.Context) bool {
+	reports, _ := ctx.Value(outcomeReportsKey{}).(bool)
+	return reports
+}
diff --git a/common/familymemory/memory_test.go b/common/familymemory/memory_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f6ad16a47bd274a13efd99ad4d1ee04c4ff09eba
