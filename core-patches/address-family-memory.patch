+++ b/common/familymemory/memory_test.go
@@ -0,0 +1,174 @@
+package familymemory
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+)
+
+var (
+	v4 = netip.MustParseAddr("194.87.115.138")
+	v6 = netip.MustParseAddr("2a03:6f02::175a")
+)
+
+type clock struct{ at time.Time }
+
+func (c *clock) now() time.Time { return c.at }
+
+func newTestMemory() (*Memory, *clock) {
+	c := &clock{at: time.Unix(1_800_000_000, 0)}
+	return New(time.Minute, c.now), c
+}
+
+func TestUnknownNameKeepsResolverPreference(t *testing.T) {
+	m, _ := newTestMemory()
+	if !m.PreferIPv6("node.example", true) || m.PreferIPv6("node.example", false) {
+		t.Fatal("an unknown name must keep the resolver preference")
+	}
+}
+
+func TestIPv4WinAfterIPv6PreferenceStartsIPv4First(t *testing.T) {
+	m, _ := newTestMemory()
+	m.Succeeded("node.example", v4)
+	if m.PreferIPv6("node.example", true) {
+		t.Fatal("IPv4 carried the last connection, it must be tried first")
+	}
+	m.Succeeded("node.example", v6)
+	if !m.PreferIPv6("node.example", true) {
+		t.Fatal("IPv6 carried the last connection, it must be tried first")
+	}
+}
+
+func TestFailureFlipsOrderUntilTTL(t *testing.T) {
+	m, c := newTestMemory()
+	m.Failed("node.example", v6)
+	got := m.Order("node.example", []netip.Addr{v6, v4}, true)
+	if got[0] != v4 || got[1] != v6 {
+		t.Fatalf("after an IPv6 failure IPv4 goes first, got %v", got)
+	}
+	c.at = c.at.Add(2 * time.Minute)
+	got = m.Order("node.example", []netip.Addr{v6, v4}, true)
+	if got[0] != v6 {
+		t.Fatalf("an expired failure must not steer the order, got %v", got)
+	}
+}
+
+func TestFailureOfWorkingFamilyForgetsIt(t *testing.T) {
+	m, _ := newTestMemory()
+	m.Succeeded("node.example", v6)
+	m.Failed("node.example", v6)
+	if m.PreferIPv6("node.example", true) {
+		t.Fatal("the family that worked and then failed must not stay first")
+	}
+	m.Failed("node.example", v4)
+	if !m.PreferIPv6("node.example", true) {
+		t.Fatal("after IPv4 failed too, the next try returns to IPv6")
+	}
+}
+
+func TestMappedIPv4CountsAsIPv4(t *testing.T) {
+	m, _ := newTestMemory()
+	m.Succeeded("node.example", netip.AddrFrom16(v4.As16()))
+	if m.PreferIPv6("node.example", true) {
+		t.Fatal("::ffff:a.b.c.d is IPv4")
+	}
+}
+
+func TestPacketWithoutReportsKeepsIPv4FirstUntilIPv6Worked(t *testing.T) {
+	m, _ := newTestMemory()
+	ctx := context.Background()
+	got := m.OrderPacket(ctx, "node.example", []netip.Addr{v6, v4}, true)
+	if got[0] != v4 {
+		t.Fatalf("a socket with no way back must not start on unproven IPv6, got %v", got)
+	}
+	m.Succeeded("node.example", v6)
+	got = m.OrderPacket(ctx, "node.example", []netip.Addr{v6, v4}, true)
+	if got[0] != v6 {
+		t.Fatalf("IPv6 proven for this name may be used, got %v", got)
+	}
+}
+
+func TestPacketWithReportsTriesIPv6First(t *testing.T) {
+	m, _ := newTestMemory()
+	ctx := WithOutcomeReports(context.Background())
+	if !ReportsOutcome(ctx) || ReportsOutcome(context.Background()) {
+		t.Fatal("outcome marker")
+	}
+	got := m.OrderPacket(ctx, "node.example", []netip.Addr{v4, v6}, true)
+	if got[0] != v6 {
+		t.Fatalf("a reporting caller starts on IPv6, got %v", got)
+	}
+	m.Failed("node.example", v6)
+	got = m.OrderPacket(ctx, "node.example", []netip.Addr{v4, v6}, true)
+	if got[0] != v4 {
+		t.Fatalf("its next connect replaces the failed family, got %v", got)
+	}
+}
+
+func TestOrderKeepsResolverOrderInsideFamilyAndDoesNotMutate(t *testing.T) {
+	m, _ := newTestMemory()
+	a4, b6 := netip.MustParseAddr("192.0.2.2"), netip.MustParseAddr("2001:db8::2")
+	input := []netip.Addr{v4, b6, a4, v6}
+	got := m.Order("node.example", input, true)
+	want := []netip.Addr{b6, v6, v4, a4}
+	if fmt.Sprint(got) != fmt.Sprint(want) {
+		t.Fatalf("got %v want %v", got, want)
+	}
+	if input[0] != v4 || input[1] != b6 {
+		t.Fatal("input slice was modified")
+	}
+}
+
+func TestResetAndEmptyName(t *testing.T) {
+	m, _ := newTestMemory()
+	m.Succeeded("", v4)
+	m.Failed("", v6)
+	m.Succeeded("node.example", v4)
+	m.Reset()
+	if !m.PreferIPv6("node.example", true) || len(m.entries) != 0 {
+		t.Fatal("Reset must forget every name, empty names are never stored")
+	}
+}
+
+func TestEntriesAreBounded(t *testing.T) {
+	m, c := newTestMemory()
+	for index := 0; index < maxEntries+10; index++ {
+		c.at = c.at.Add(time.Millisecond)
+		m.Succeeded(fmt.Sprintf("node-%d.example", index), v4)
+	}
+	if len(m.entries) != maxEntries {
+		t.Fatalf("entries=%d", len(m.entries))
+	}
+	if _, kept := m.entries["node-0.example"]; kept {
+		t.Fatal("the oldest entry must be dropped first")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	m := New(time.Minute, nil)
+	var group sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		group.Add(1)
+		go func(worker int) {
+			defer group.Done()
+			name := fmt.Sprintf("node-%d.example", worker%3)
+			for index := 0; index < 500; index++ {
+				switch index % 4 {
+				case 0:
+					m.Succeeded(name, v6)
+				case 1:
+					m.Failed(name, v4)
+				case 2:
+					_ = m.Order(name, []netip.Addr{v4, v6}, true)
+				default:
+					_ = m.OrderPacket(context.Background(), name, []netip.Addr{v4, v6}, true)
+				}
+			}
+			m.Reset()
+		}(worker)
+	}
+	group.Wait()
+}
