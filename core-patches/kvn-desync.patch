+	}
+	after, _ := getTTL(sc, false)
+	conn.Close()
+	<-received
+	if before != after {
+		t.Fatalf("ttl %d -> %d", before, after)
+	}
+}
+
+// TestLab needs a TLS server at least one router hop away:
+// set KVN_DESYNC_LAB=host:443 KVN_DESYNC_LAB_SNI=name. Disorder must leave the handshake
+// intact: the TTL 1 piece died in path and the stack retransmitted it with the normal TTL.
+func TestLab(t *testing.T) {
+	address, sni := os.Getenv("KVN_DESYNC_LAB"), os.Getenv("KVN_DESYNC_LAB_SNI")
+	if address == "" || sni == "" {
+		t.Skip("KVN_DESYNC_LAB / KVN_DESYNC_LAB_SNI not set")
+	}
+	for _, plan := range []*Plan{
+		{Method: MethodDisorder, SplitAt: SplitSNI, FakeTTL: DefaultTTL},
+		{Method: MethodSplit, SplitAt: SplitSNI, FakeTTL: DefaultTTL},
+	} {
+		raw, err := net.DialTimeout("tcp", address, 5*time.Second)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = raw.SetDeadline(time.Now().Add(15 * time.Second))
+		var failed error
+		conn := Client(raw, plan, func(err error) { failed = err })
+		started := time.Now()
+		err = tls.Client(conn, &tls.Config{ServerName: sni}).Handshake()
+		raw.Close()
+		if failed != nil {
+			t.Fatalf("%s: plan did not run: %v", plan, failed)
+		}
+		if err != nil {
+			t.Errorf("%s: handshake failed: %v", plan, err)
+		} else {
+			t.Logf("%s: handshake ok in %v", plan, time.Since(started).Round(time.Millisecond))
+		}
+	}
+}
diff --git a/common/kvndesync/plan.go b/common/kvndesync/plan.go
new file mode 100644
index 0000000000000000000000000000000000000000..34353b804f3dae918c59d1c0613c713bfa91e7f3
--- /dev/null
+++ b/common/kvndesync/plan.go
@@ -0,0 +1,221 @@
+// Package kvndesync shapes the first write of an app socket to the VPN server so that
+// in-path DPI misreads it, from an ordinary connected socket: no root, no raw sockets,
+// no driver (Zapret KVN masking-design/04).
+//
+// The app decides the plan (the :masking module); this package only executes it. Every
+// method keeps the stream intact: the server receives exactly the bytes that were written,
+// once, in order.
+//
+//   - split:    the first write goes out in two TCP segments, cut at the plan's offset.
+//   - disorder: the first piece goes out with TTL 1 and dies at the first router; the
+//     kernel retransmits it after the second piece, so the path sees the pieces reversed.
+//   - oob:      one urgent byte (MSG_OOB) after the first piece; the server's stream drops
+//     it (no SO_OOBINLINE), a reassembling DPI does not.
+//   - fake:     a decoy ClientHello of the same length with another SNI goes out first with
+//     a low TTL that dies before the server; the kernel then retransmits the REAL bytes
+//     from the same page (Linux vmsplice, the ByeDPI technique).
+package kvndesync
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"fmt"
+	"strconv"
+	"strings"
+
+	tf "github.com/sagernet/sing-box/common/tlsfragment"
+)
+
+type Method string
+
+const (
+	MethodSplit    Method = "split"
+	MethodDisorder Method = "disorder"
+	MethodOOB      Method = "oob"
+	MethodFake     Method = "fake"
+)
+
+// SplitSNI cuts one byte into the server name, so that no segment carries it whole.
+const SplitSNI = "sni"
+
+const (
+	MaxOffset   = 1400
+	MaxTTL      = 32
+	DefaultTTL  = 3
+	maxHostname = 253
+)
+
+type Plan struct {
+	Method  Method
+	SplitAt string // SplitSNI or a decimal byte offset 1..MaxOffset
+	FakeTTL int
+	FakeSNI string
+}
+
+// Parse reads the plan the app wrote (`xray_masking.desync`). Strict: an unknown key or an
+// out-of-range number is an error, so the core never runs something the app did not mean.
+func Parse(value any) (*Plan, error) {
+	fields, ok := value.(map[string]any)
+	if !ok {
+		return nil, fmt.Errorf("desync: want an object")
+	}
+	plan := &Plan{SplitAt: SplitSNI, FakeTTL: DefaultTTL}
+	for key, raw := range fields {
+		switch key {
+		case "method":
+			text, _ := raw.(string)
+			plan.Method = Method(text)
+		case "split_at":
+			text, ok := raw.(string)
+			if !ok {
+				return nil, fmt.Errorf("desync.split_at: want a string")
+			}
+			plan.SplitAt = text
+		case "fake_ttl":
+			number, ok := raw.(float64)
+			if !ok || number != float64(int(number)) {
+				return nil, fmt.Errorf("desync.fake_ttl: want an integer")
+			}
+			plan.FakeTTL = int(number)
+		case "fake_sni":
+			text, ok := raw.(string)
+			if !ok {
+				return nil, fmt.Errorf("desync.fake_sni: want a string")
+			}
+			plan.FakeSNI = text
+		default:
+			return nil, fmt.Errorf("desync: unknown key %s", key)
+		}
+	}
+	switch plan.Method {
+	case MethodSplit, MethodDisorder, MethodOOB, MethodFake:
+	default:
+		return nil, fmt.Errorf("desync.method: %q", plan.Method)
+	}
+	if plan.SplitAt != SplitSNI {
+		offset, err := strconv.Atoi(plan.SplitAt)
+		if err != nil || offset < 1 || offset > MaxOffset {
+			return nil, fmt.Errorf("desync.split_at: %q", plan.SplitAt)
+		}
+	}
+	if plan.FakeTTL < 1 || plan.FakeTTL > MaxTTL {
+		return nil, fmt.Errorf("desync.fake_ttl: %d", plan.FakeTTL)
+	}
+	if plan.Method == MethodFake && !validHostname(plan.FakeSNI) {
+		return nil, fmt.Errorf("desync.fake_sni: %q", plan.FakeSNI)
+	}
+	return plan, nil
+}
+
+func (p *Plan) String() string {
+	switch p.Method {
+	case MethodFake:
+		return fmt.Sprintf("fake ttl=%d sni=%s", p.FakeTTL, p.FakeSNI)
+	case MethodDisorder:
+		return "disorder at " + p.SplitAt
+	default:
+		return string(p.Method) + " at " + p.SplitAt
+	}
+}
+
+// SplitPos is where the first write is cut: inside the server name, or the fixed offset.
+// 0 means "do not cut" (the write is too short, or a TLS record without a server name).
+func (p *Plan) SplitPos(first []byte) int {
+	var pos int
+	if p.SplitAt == SplitSNI {
+		name := tf.IndexTLSServerName(first)
+		if name == nil || name.Length < 2 {
+			return 0
+		}
+		pos = name.Index + 1
+	} else {
+		pos, _ = strconv.Atoi(p.SplitAt)
+	}
+	if pos <= 0 || pos >= len(first) {
+		return 0
+	}
+	return pos
+}
+
+func validHostname(host string) bool {
+	if host == "" || len(host) > maxHostname || strings.HasPrefix(host, ".") || strings.HasSuffix(host, ".") {
+		return false
+	}
+	for _, label := range strings.Split(host, ".") {
+		if label == "" || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for _, r := range label {
+			if !(r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// FakeClientHello is a well-formed TLS 1.3 ClientHello for sni, exactly length bytes long
+// (a padding extension fills the rest), with fresh random, session id and key share. When
+// length is below the smallest such record, the record is cut to length: the decoy must have
+// the same length as the real bytes it stands in for.
+func FakeClientHello(length int, sni string) []byte {
+	var extensions []byte
+	host := []byte(sni)
+	// server_name
+	extensions = appendExtension(extensions, 0x0000, func(b []byte) []byte {
+		b = binary.BigEndian.AppendUint16(b, uint16(len(host)+3))
+		b = append(b, 0)
+		b = binary.BigEndian.AppendUint16(b, uint16(len(host)))
+		return append(b, host...)
+	})
+	// supported_groups: x25519
+	extensions = appendExtension(extensions, 0x000a, func(b []byte) []byte { return append(b, 0, 2, 0, 0x1d) })
+	// signature_algorithms
+	extensions = appendExtension(extensions, 0x000d, func(b []byte) []byte {
+		return append(b, 0, 8, 0x04, 0x03, 0x08, 0x04, 0x04, 0x01, 0x05, 0x03)
+	})
+	// supported_versions: TLS 1.3, 1.2
+	extensions = appendExtension(extensions, 0x002b, func(b []byte) []byte { return append(b, 4, 0x03, 0x04, 0x03, 0x03) })
+	// key_share: x25519 with a random key
+	extensions = appendExtension(extensions, 0x0033, func(b []byte) []byte {
+		b = append(b, 0, 36, 0, 0x1d, 0, 32)
+		return append(b, random(32)...)
+	})
+	body := []byte{0x03, 0x03}
+	body = append(body, random(32)...)
+	body = append(body, 32)
+	body = append(body, random(32)...)
+	body = append(body, 0, 6, 0x13, 0x01, 0x13, 0x02, 0x13, 0x03)
+	body = append(body, 1, 0)
+	const fixed = 5 + 4 + 2 // record header, handshake header, extensions length
+	padding := length - fixed - len(body) - len(extensions) - 4
+	if padding >= 0 {
+		extensions = appendExtension(extensions, 0x0015, func(b []byte) []byte { return append(b, make([]byte, padding)...) })
+	}
+	body = binary.BigEndian.AppendUint16(body, uint16(len(extensions)))
+	body = append(body, extensions...)
+	handshake := []byte{1, byte(len(body) >> 16), byte(len(body) >> 8), byte(len(body))}
+	handshake = append(handshake, body...)
+	record := []byte{0x16, 0x03, 0x01}
+	record = binary.BigEndian.AppendUint16(record, uint16(len(handshake)))
+	record = append(record, handshake...)
+	if len(record) > length {
+		record = record[:length]
+	}
+	return record
+}
+
+func appendExtension(b []byte, kind uint16, data func([]byte) []byte) []byte {
+	b = binary.BigEndian.AppendUint16(b, kind)
+	start := len(b)
+	b = append(b, 0, 0)
+	b = data(b)
+	binary.BigEndian.PutUint16(b[start:], uint16(len(b)-start-2))
+	return b
+}
+
+func random(n int) []byte {
+	b := make([]byte, n)
+	_, _ = rand.Read(b)
+	return b
+}
diff --git a/common/kvndesync/plan_test.go b/common/kvndesync/plan_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..da424ab632fbb6acd83b67a16d967047104180e4
--- /dev/null
+++ b/common/kvndesync/plan_test.go
@@ -0,0 +1,90 @@
+package kvndesync
+
+import (
+	"bytes"
+	"crypto/tls"
+	"net"
+	"testing"
+	"time"
+
+	tf "github.com/sagernet/sing-box/common/tlsfragment"
+)
+
+// clientHello is the first write of a real Go TLS client for host.
+func clientHello(t *testing.T, host string) []byte {
+	t.Helper()
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() {
+		_ = tls.Client(client, &tls.Config{ServerName: host}).Handshake()
+		client.Close()
+	}()
+	_ = server.SetReadDeadline(time.Now().Add(5 * time.Second))
+	buf := make([]byte, 64*1024)
+	n, err := server.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return buf[:n]
+}
+
+func TestParseIsStrict(t *testing.T) {
+	plan, err := Parse(map[string]any{"method": "fake", "fake_ttl": float64(4), "fake_sni": "vk.com"})
+	if err != nil || plan.FakeTTL != 4 || plan.SplitAt != SplitSNI {
+		t.Fatalf("plan %+v err %v", plan, err)
+	}
+	for _, bad := range []map[string]any{
+		{"method": "spoof"},
+		{"method": "split", "split_at": "0"},
+		{"method": "split", "split_at": "1401"},
+		{"method": "split", "ttl": float64(3)},
+		{"method": "fake", "fake_sni": "vk.com", "fake_ttl": float64(33)},
+		{"method": "fake", "fake_sni": "VK.com"},
+		{"method": "fake"},
+		{"method": "disorder", "fake_ttl": 2.5},
+	} {
+		if _, err := Parse(bad); err == nil {
+			t.Errorf("accepted %v", bad)
+		}
+	}
+}
+
+func TestSplitPosCutsInsideTheServerName(t *testing.T) {
+	hello := clientHello(t, "example.com")
+	name := tf.IndexTLSServerName(hello)
+	if name == nil {
+		t.Fatal("no server name")
+	}
+	plan := &Plan{Method: MethodSplit, SplitAt: SplitSNI}
+	if got := plan.SplitPos(hello); got != name.Index+1 {
+		t.Fatalf("split at %d, name at %d", got, name.Index)
+	}
+	if got := (&Plan{SplitAt: "5"}).SplitPos(hello); got != 5 {
+		t.Fatalf("fixed offset: %d", got)
+	}
+	if got := plan.SplitPos([]byte("GET / HTTP/1.1\r\n")); got != 0 {
+		t.Fatalf("no TLS record must not be cut by sni: %d", got)
+	}
+	if got := (&Plan{SplitAt: "100"}).SplitPos(make([]byte, 50)); got != 0 {
+		t.Fatalf("offset past the write: %d", got)
+	}
+}
+
+func TestFakeClientHelloHasTheLengthAndTheDecoyName(t *testing.T) {
+	for _, length := range []int{180, 517, 1800, 4000} {
+		fake := FakeClientHello(length, "vk.com")
+		if len(fake) != length {
+			t.Fatalf("length %d: got %d", length, len(fake))
+		}
+		name := tf.IndexTLSServerName(fake)
+		if name == nil || name.ServerName != "vk.com" {
+			t.Fatalf("length %d: server name %+v", length, name)
+		}
+	}
+	if bytes.Equal(FakeClientHello(517, "vk.com"), FakeClientHello(517, "vk.com")) {
+		t.Fatal("two decoys must differ (random, session id, key share)")
+	}
+	if short := FakeClientHello(40, "vk.com"); len(short) != 40 || short[0] != 0x16 {
+		t.Fatalf("short decoy %x", short)
+	}
+}
diff --git a/common/kvndesync/socket_linux.go b/common/kvndesync/socket_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..dfaa4089376878b5796fd25e3d66c05da4af04eb
--- /dev/null
+++ b/common/kvndesync/socket_linux.go
@@ -0,0 +1,187 @@
+//go:build linux
+
+package kvndesync
+
+import (
+	"net"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// pageSizeLimit caps the decoy: it lives in one vmsplice'd buffer.
+const pageSizeLimit = 16 * 1024
+
+func ttlOption(v6 bool) (int, int) {
+	if v6 {
+		return unix.IPPROTO_IPV6, unix.IPV6_UNICAST_HOPS
+	}
+	return unix.IPPROTO_IP, unix.IP_TTL
+}
+
+func control(raw syscall.RawConn, f func(fd int) error) error {
+	var inner error
+	if err := raw.Control(func(fd uintptr) { inner = f(int(fd)) }); err != nil {
+		return err
+	}
+	return inner
+}
+
+func getTTL(raw syscall.RawConn, v6 bool) (int, error) {
+	level, name := ttlOption(v6)
+	var ttl int
+	err := control(raw, func(fd int) error {
+		var err error
+		ttl, err = unix.GetsockoptInt(fd, level, name)
+		return err
+	})
+	return ttl, err
+}
+
+func setTTL(raw syscall.RawConn, ttl int, v6 bool) error {
+	level, name := ttlOption(v6)
+	return control(raw, func(fd int) error { return unix.SetsockoptInt(fd, level, name, ttl) })
+}
+
+// waitSent waits (bounded) until the kernel handed every queued byte to IP; kernels without
+// tcpi_notsent_bytes report 0 at once, and the short floor covers them.
+func waitSent(raw syscall.RawConn) {
+	deadline := time.Now().Add(sentWait)
+	time.Sleep(time.Millisecond)
+	for time.Now().Before(deadline) {
+		var notSent uint32 = 1
+		_ = control(raw, func(fd int) error {
+			info, err := unix.GetsockoptTCPInfo(fd, unix.IPPROTO_TCP, unix.TCP_INFO)
+			if err == nil {
+				notSent = info.Notsent_bytes
+			}
+			return err
+		})
+		if notSent == 0 {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// writeWithTTL writes piece with a temporary TTL and restores the socket's own TTL only after
+// the piece left the host, so the piece can never go out with the normal TTL by accident.
+func writeWithTTL(raw syscall.RawConn, tcp *net.TCPConn, piece []byte, ttl int, v6 bool) error {
+	old, err := getTTL(raw, v6)
+	if err != nil {
+		return beforeSend{err}
+	}
+	if err := setTTL(raw, ttl, v6); err != nil {
+		return beforeSend{err}
+	}
+	_, werr := tcp.Write(piece)
+	waitSent(raw)
+	if err := setTTL(raw, old, v6); err != nil && werr == nil {
+		werr = err
+	}
+	return werr
+}
+
+// writeOOB sends piece followed by one urgent byte; the server's stream never contains it.
+func writeOOB(raw syscall.RawConn, piece []byte) error {
+	buf := append(append(make([]byte, 0, len(piece)+1), piece...), 'a')
+	var sendErr error
+	sent := 0
+	err := raw.Write(func(fd uintptr) bool {
+		for sent < len(buf) {
+			// Only the last byte of the last send is urgent: send the piece first, then the byte.
+			chunk, flags := buf[sent:len(buf)-1], 0
+			if sent >= len(buf)-1 {
+				chunk, flags = buf[len(buf)-1:], unix.MSG_OOB
+			}
+			n, err := unix.SendmsgN(int(fd), chunk, nil, nil, flags|unix.MSG_NOSIGNAL)
+			if err == unix.EAGAIN {
+				return false
+			}
+			if err != nil {
+				sendErr = err
+				return true
+			}
+			sent += n
+		}
+		return true
+	})
+	if err != nil {
+		return err
+	}
+	if sendErr != nil && sent == 0 {
+		return beforeSend{sendErr}
+	}
+	return sendErr
+}
+
+// sendFake puts decoy (same length as real) on the wire with a low TTL from a page the socket
+// references without copying (vmsplice + splice), waits until it left the host, then writes the
+// real bytes into the same page and restores the TTL: the kernel's retransmission carries the
+// real bytes. sent=false: nothing reached the socket and the caller writes plainly.
+func sendFake(raw syscall.RawConn, real []byte, decoy []byte, ttl int, v6 bool) (bool, error) {
+	size := (len(real) + unix.Getpagesize() - 1) &^ (unix.Getpagesize() - 1)
+	page, err := unix.Mmap(-1, 0, size, unix.PROT_READ|unix.PROT_WRITE, unix.MAP_SHARED|unix.MAP_ANONYMOUS)
+	if err != nil {
+		return false, err
+	}
+	defer unix.Munmap(page)
+	copy(page, decoy)
+	var pipe [2]int
+	if err := unix.Pipe2(pipe[:], unix.O_CLOEXEC); err != nil {
+		return false, err
+	}
+	defer unix.Close(pipe[0])
+	defer unix.Close(pipe[1])
+	old, err := getTTL(raw, v6)
+	if err != nil {
+		return false, err
+	}
+	if err := setTTL(raw, ttl, v6); err != nil {
+		return false, err
+	}
+	iov := []unix.Iovec{{Base: &page[0]}}
+	iov[0].SetLen(len(real))
+	queued, err := unix.Vmsplice(pipe[1], iov, unix.SPLICE_F_GIFT)
+	if err != nil || queued != len(real) {
+		_ = setTTL(raw, old, v6)
+		if err == nil {
+			err = unix.EIO
+		}
+		return false, err
+	}
+	var spliceErr error
+	moved := 0
+	werr := raw.Write(func(fd uintptr) bool {
+		for moved < queued {
+			n, err := unix.Splice(pipe[0], nil, int(fd), nil, queued-moved, unix.SPLICE_F_NONBLOCK)
+			if err == unix.EAGAIN {
+				return false
+			}
+			if err != nil {
+				spliceErr = err
+				return true
+			}
+			moved += int(n)
+		}
+		return true
+	})
+	if werr == nil {
+		werr = spliceErr
+	}
+	if moved == 0 {
+		_ = setTTL(raw, old, v6)
+		return false, werr
+	}
+	waitSent(raw)
+	// From here every (re)transmission of these bytes reads the real data.
+	copy(page, real)
+	if err := setTTL(raw, old, v6); err != nil && werr == nil {
+		werr = err
+	}
+	if werr == nil && moved != len(real) {
+		werr = unix.EIO
+	}
+	return true, werr
+}
