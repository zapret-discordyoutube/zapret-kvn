@@ -0,0 +1,22 @@
+package kvndesync
+
+import "testing"
+
+func TestZapretSpecReadsTheWindowsRouteOption(t *testing.T) {
+	plan, err := ParseSpec("disorder:sni")
+	if err != nil || plan.Method != MethodDisorder || plan.SplitAt != SplitSNI {
+		t.Fatalf("plan %+v err %v", plan, err)
+	}
+	plan, err = ParseSpec("split:120")
+	if err != nil || plan.Method != MethodSplit || plan.SplitAt != "120" {
+		t.Fatalf("plan %+v err %v", plan, err)
+	}
+	if plan, err := ParseSpec(""); plan != nil || err != nil {
+		t.Fatalf("empty: %+v %v", plan, err)
+	}
+	for _, bad := range []string{"disorder", "disorder:", "fake:sni", "oob:sni", "split:0", "split:1401", "spoof:sni", "split:sni:1"} {
+		if _, err := ParseSpec(bad); err == nil {
+			t.Errorf("%q accepted", bad)
+		}
+	}
+}
diff --git a/option/rule_action.go b/option/rule_action.go
index a81634d112845f671c83648c38ad3a22c5425f98..a73e6298c9298ae0fbf1f087d75475b67abc5f43 100644
--- a/option/rule_action.go
