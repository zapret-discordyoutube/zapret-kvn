+			conn := Client(raw, &Plan{Method: method, SplitAt: SplitSNI, FakeTTL: DefaultTTL}, func(err error) { failed = err })
+			if n, err := conn.Write(hello); err != nil || n != len(hello) {
+				t.Fatalf("write %d %v", n, err)
+			}
+			if _, err := conn.Write([]byte("after")); err != nil {
+				t.Fatal(err)
+			}
+			conn.Close()
+			got := <-received
+			if failed != nil {
+				t.Fatalf("plan did not run: %v", failed)
+			}
+			if want := append(append([]byte{}, hello...), "after"...); !bytes.Equal(got, want) {
+				t.Fatalf("stream differs: got %d bytes, want %d", len(got), len(want))
+			}
+		})
+	}
+}
+
+func TestFakeAndOOBFallBackToAPlainWrite(t *testing.T) {
+	hello := clientHello(t, "example.com")
+	for _, method := range []Method{MethodFake, MethodOOB} {
+		t.Run(string(method), func(t *testing.T) {
+			raw, received := loopback(t)
+			var failed error
+			conn := Client(raw, &Plan{Method: method, SplitAt: SplitSNI, FakeTTL: 3, FakeSNI: "vk.com"}, func(err error) { failed = err })
+			if n, err := conn.Write(hello); err != nil || n != len(hello) {
+				t.Fatalf("write %d %v", n, err)
+			}
+			conn.Close()
+			if got := <-received; !bytes.Equal(got, hello) {
+				t.Fatalf("got %d bytes, want the plain hello", len(got))
+			}
+			if failed != errUnsupported {
+				t.Fatalf("report %v, want errUnsupported", failed)
+			}
+		})
+	}
+}
+
+func TestTTLIsRestoredAfterTheTrick(t *testing.T) {
+	hello := clientHello(t, "example.com")
+	raw, received := loopback(t)
+	sc, _ := raw.SyscallConn()
+	before, err := getTTL(sc, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := bytesOut(sc); !ok {
+		t.Log("SIO_TCP_INFO unavailable: waitSent uses the floor only")
+	}
+	conn := Client(raw, &Plan{Method: MethodDisorder, SplitAt: SplitSNI, FakeTTL: DefaultTTL}, nil)
+	if _, err := conn.Write(hello); err != nil {
