diff --git a/common/kvndesync/socket_windows.go b/common/kvndesync/socket_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..cda6531971d15dddbfd28dbfba597d978735a64c
--- /dev/null
+++ b/common/kvndesync/socket_windows.go
@@ -0,0 +1,111 @@
+//go:build windows
+
+package kvndesync
+
+import (
+	"encoding/binary"
+	"net"
+	"syscall"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// pageSizeLimit caps the piece the decoy would stand in for; Windows has no decoy here
+// (the app uses sing-box tls_spoof over WinDivert for that), the constant keeps conn.go shared.
+const pageSizeLimit = 16 * 1024
+
+// sioTCPInfo is SIO_TCP_INFO (_WSAIORW(IOC_VENDOR, 39)), Windows 10 1703 and later.
+const sioTCPInfo = 0xD8000027
+
+// tcpInfoSize and tcpInfoBytesOut: the size of TCP_INFO_v0 and the offset of its BytesOut.
+const (
+	tcpInfoSize     = 88
+	tcpInfoBytesOut = 48
+)
+
+func ttlOption(v6 bool) (int32, int32) {
+	if v6 {
+		return windows.IPPROTO_IPV6, windows.IPV6_UNICAST_HOPS
+	}
+	return windows.IPPROTO_IP, windows.IP_TTL
+}
+
+func control(raw syscall.RawConn, f func(fd windows.Handle) error) error {
+	var inner error
+	if err := raw.Control(func(fd uintptr) { inner = f(windows.Handle(fd)) }); err != nil {
+		return err
+	}
+	return inner
+}
+
+func getTTL(raw syscall.RawConn, v6 bool) (int, error) {
+	level, name := ttlOption(v6)
+	var ttl int
+	err := control(raw, func(fd windows.Handle) error {
+		var err error
+		ttl, err = windows.GetsockoptInt(fd, int(level), int(name))
+		return err
+	})
+	return ttl, err
+}
+
+func setTTL(raw syscall.RawConn, ttl int, v6 bool) error {
+	level, name := ttlOption(v6)
+	return control(raw, func(fd windows.Handle) error { return windows.SetsockoptInt(fd, int(level), int(name), ttl) })
+}
+
+// bytesOut reads TCP_INFO_v0.BytesOut: bytes the stack handed to IP, retransmissions included.
+func bytesOut(raw syscall.RawConn) (uint64, bool) {
+	var info [tcpInfoSize]byte
+	version := uint32(0)
+	var returned uint32
+	err := control(raw, func(fd windows.Handle) error {
+		return windows.WSAIoctl(fd, sioTCPInfo, (*byte)(unsafe.Pointer(&version)), 4,
+			&info[0], tcpInfoSize, &returned, nil, 0)
+	})
+	if err != nil || returned < tcpInfoBytesOut+8 {
+		return 0, false
+	}
+	return binary.LittleEndian.Uint64(info[tcpInfoBytesOut:]), true
+}
+
+// waitSent waits (bounded) until the stack sent want more bytes than before; without
+// SIO_TCP_INFO only the short floor is waited.
+func waitSent(raw syscall.RawConn, before uint64, known bool, want int) {
+	deadline := time.Now().Add(sentWait)
+	time.Sleep(time.Millisecond)
+	if !known {
+		return
+	}
+	for time.Now().Before(deadline) {
+		if out, ok := bytesOut(raw); !ok || out >= before+uint64(want) {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+// writeWithTTL writes piece with a temporary TTL and restores the socket's own TTL only after
+// the piece left the host, so the piece can never go out with the normal TTL by accident.
+func writeWithTTL(raw syscall.RawConn, tcp *net.TCPConn, piece []byte, ttl int, v6 bool) error {
+	old, err := getTTL(raw, v6)
+	if err != nil {
+		return beforeSend{err}
+	}
+	before, known := bytesOut(raw)
+	if err := setTTL(raw, ttl, v6); err != nil {
+		return beforeSend{err}
+	}
+	_, werr := tcp.Write(piece)
+	waitSent(raw, before, known, len(piece))
+	if err := setTTL(raw, old, v6); err != nil && werr == nil {
+		werr = err
+	}
+	return werr
+}
+
+func writeOOB(syscall.RawConn, []byte) error { return errUnsupported }
+
+func sendFake(syscall.RawConn, []byte, []byte, int, bool) (bool, error) { return false, errUnsupported }
diff --git a/common/kvndesync/spec.go b/common/kvndesync/spec.go
new file mode 100644
index 0000000000000000000000000000000000000000..87cb7e53e01e1bdf4fa784dc938786f349d5aa6d
--- /dev/null
+++ b/common/kvndesync/spec.go
@@ -0,0 +1,28 @@
+package kvndesync
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ParseSpec reads the route option `kvn_desync` the Windows app writes for the rule of one
+// VPN server: "method:split_at", for example "disorder:sni" or "split:120". Only the methods
+// an ordinary socket runs on Windows are accepted: the decoy there is sing-box `tls_spoof`
+// over WinDivert, and OOB depends on a path that keeps the URG flag. Empty means no plan.
+func ParseSpec(spec string) (*Plan, error) {
+	if spec == "" {
+		return nil, nil
+	}
+	method, splitAt, found := strings.Cut(spec, ":")
+	if !found || splitAt == "" {
+		return nil, fmt.Errorf("kvn_desync: want method:split_at, got %q", spec)
+	}
+	switch Method(method) {
+	case MethodSplit, MethodDisorder:
+	case MethodFake:
+		return nil, fmt.Errorf("kvn_desync: the decoy is tls_spoof, not %q", spec)
+	default:
+		return nil, fmt.Errorf("kvn_desync: method %q is not available here", method)
+	}
+	return Parse(map[string]any{"method": method, "split_at": splitAt})
+}
diff --git a/common/kvndesync/zapret_spec_test.go b/common/kvndesync/zapret_spec_test.go
