+	for range 4 {
+		ctx, cancel := context.WithCancel(context.Background())
+		go func() {
+			time.Sleep(50 * time.Millisecond)
+			cancel()
+		}()
+		_, _ = hop.DialContext(ctx, N.NetworkTCP, destination)
+	}
+	if hop.failures != 0 {
