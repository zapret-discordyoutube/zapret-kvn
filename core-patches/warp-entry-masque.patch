+// hangingTunnel never answers a dial until its context ends, like a tunnel the network went silent on.
+type hangingTunnel struct{ fakeTunnel }
+
+
+func (h *hangingTunnel) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	<-ctx.Done()
+	return nil, ctx.Err()
+}
+
+func TestADialThatHangsPastTheSlowLimitCountsEvenWhenTheCallerOnlyCancels(t *testing.T) {
+	hanging := &hangingTunnel{}
+	alive := &fakeTunnel{name: "masque"}
+	alive.alive.Store(true)
+	hop := newHop(t, []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}, func(candidate) (adapter.Endpoint, error) {
+		return alive, nil
+	}, hanging)
+	destination := M.ParseSocksaddrHostPort("203.0.113.9", 443)
+	for range 2 {
+		ctx, cancel := context.WithTimeout(context.Background(), slowDial+time.Second)
+		go func() {
+			defer cancel()
+			_, _ = hop.DialContext(ctx, N.NetworkTCP, destination)
+		}()
+	}
+	waitFor(t, func() bool { return hop.active() == adapter.Endpoint(alive) })
+}
