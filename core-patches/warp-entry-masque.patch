+func TestMasqueCandidatesFollowTheAccountsOwnWireGuardAddressAndItsSecondPort(t *testing.T) {
+	got := withMasque(peerCandidates(accountPeer(), "", 0))
+	if len(got) != startAttempts+2 {
+		t.Fatalf("want %d candidates, got %v", startAttempts+2, got)
+	}
+	want := []transport{
+		transportWireGuard, transportWireGuard, transportMasqueQUIC, transportMasqueHTTP2,
+		transportWireGuard, transportWireGuard, transportWireGuard, transportWireGuard, transportWireGuard, transportWireGuard,
+	}
+	for index, kind := range want {
+		if got[index].transport != kind {
+			t.Fatalf("candidate %d is %v, want %v (%v)", index, got[index].transport, kind, got)
+		}
+	}
+}
+
+func TestTransportNamesRoundTrip(t *testing.T) {
+	for _, kind := range []transport{transportMasqueQUIC, transportMasqueHTTP2} {
+		parsed, ok := parseTransport(kind.String())
+		if !ok || parsed != kind {
+			t.Fatalf("%v did not round-trip: %v %v", kind, parsed, ok)
+		}
+	}
+	if _, ok := parseTransport("wireguard"); ok {
+		t.Fatal("wireguard is not a remembered MASQUE transport")
+	}
+}
+
+func TestRotationAfterAWireGuardFailureTriesMasqueBeforeAnotherWireGuardPort(t *testing.T) {
+	list := withMasque(peerCandidates(accountPeer(), "", 0))
+	order := rotationOrder(list, 0, map[transport]bool{transportWireGuard: true})
+	if len(order) != len(list)-1 {
+		t.Fatalf("every other candidate is a next one: %v", order)
+	}
+	if list[order[0]].transport != transportMasqueQUIC || list[order[1]].transport != transportMasqueHTTP2 {
+		t.Fatalf("MASQUE must come first after a WireGuard failure: %v", order)
+	}
+	for _, index := range order[2:] {
+		if list[index].transport != transportWireGuard {
+			t.Fatalf("only the demoted WireGuard candidates are left at the end: %v", order)
+		}
+	}
+}
+
+func TestRotationAfterAMasqueFailureKeepsTheOtherTransportsFirst(t *testing.T) {
+	list := withMasque(peerCandidates(accountPeer(), "", 0))
+	order := rotationOrder(list, 2, map[transport]bool{transportMasqueQUIC: true})
+	if list[order[0]].transport == transportMasqueQUIC {
+		t.Fatalf("the failed transport goes last: %v", order)
+	}
+	if list[order[len(order)-1]].transport != transportMasqueQUIC && list[order[len(order)-1]].transport != transportWireGuard {
+		t.Fatalf("unexpected tail %v", order)
+	}
+}
+
+func TestMemoryHoldsAMasqueTransportAndExpires(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "profile.json.edge")
+	if err := saveEdgeMemory(path, candidate{transport: transportMasqueHTTP2}); err != nil {
+		t.Fatal(err)
+	}
+	got, ok := loadEdgeMemory(path)
+	if !ok || got.transport != transportMasqueHTTP2 {
+		t.Fatalf("got %v %v", got, ok)
+	}
+	old := time.Now().Add(-edgeMemoryLifetime - time.Hour)
+	if err := os.Chtimes(path, old, old); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok = loadEdgeMemory(path); ok {
+		t.Fatal("a hint from another day must not decide the first attempt")
+	}
+}
+
+func TestTimeoutsAreTunnelFailuresRefusalsAreNot(t *testing.T) {
+	if !isTimeout(context.DeadlineExceeded) || !isTimeout(&net.DNSError{IsTimeout: true}) || !isTimeout(errors.New("dial tcp: i/o timeout")) {
+		t.Fatal("a silent tunnel shows as a timeout")
+	}
+	if isTimeout(errors.New("connection refused")) || isTimeout(context.Canceled) || isTimeout(nil) {
+		t.Fatal("a refusal or a cancel says nothing about the tunnel")
+	}
+}
+
+// fakeTunnel is a tunnel whose connections either time out or open, nothing else.
+type fakeTunnel struct {
+	adapter.Endpoint
+	name   string
+	alive  atomic.Bool
+	dialed atomic.Int32
+	closed atomic.Bool
+}
+
+func (f *fakeTunnel) Type() string { return "fake" }
+func (f *fakeTunnel) Tag() string  { return f.name }
+func (f *fakeTunnel) Start(adapter.StartStage, *adapter.Scope) error {
+	return nil
+}
+
+func (f *fakeTunnel) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	f.dialed.Add(1)
+	if f.alive.Load() {
+		client, server := net.Pipe()
+		_ = server.Close()
+		return client, nil
+	}
+	return nil, context.DeadlineExceeded
+}
+
+func newHop(t *testing.T, list []candidate, build func(candidate) (adapter.Endpoint, error), first adapter.Endpoint) *Endpoint {
+	t.Helper()
+	logger := log.NewNOPFactory().Logger()
+	hop := &Endpoint{
+		ctx:         context.Background(),
+		logger:      logger,
+		await:       make(chan struct{}),
+		list:        list,
+		build:       build,
+		scope:       adapter.NewScope(context.Background(), logger),
+		endpoint:    first,
+		lastSuccess: time.Now().Add(-time.Hour),
+	}
+	close(hop.await)
+	return hop
+}
+
+func waitFor(t *testing.T, condition func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		if condition() {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("the condition never came true")
+}
+
+func TestADeadTunnelIsReplacedAfterTwoTimeoutsInARow(t *testing.T) {
+	dead := &fakeTunnel{name: "wireguard"}
+	masqueTunnel := &fakeTunnel{name: "masque"}
+	masqueTunnel.alive.Store(true)
+	list := []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}
+	var built []transport
+	hop := newHop(t, list, func(current candidate) (adapter.Endpoint, error) {
+		built = append(built, current.transport)
+		return masqueTunnel, nil
+	}, dead)
+	var remembered atomic.Int32
+	hop.remember = func(candidate) { remembered.Add(1) }
+
+	destination := M.ParseSocksaddrHostPort("203.0.113.9", 443)
+	if _, err := hop.DialContext(context.Background(), N.NetworkTCP, destination); err == nil {
+		t.Fatal("a dead tunnel must fail the dial")
+	}
+	if hop.active() != adapter.Endpoint(dead) {
+		t.Fatal("one timeout is a bad destination, not a dead tunnel")
+	}
+	if _, err := hop.DialContext(context.Background(), N.NetworkTCP, destination); err == nil {
+		t.Fatal("a dead tunnel must fail the dial")
+	}
+	waitFor(t, func() bool { return hop.active() == adapter.Endpoint(masqueTunnel) })
+	if !reflect.DeepEqual(built, []transport{transportMasqueQUIC}) {
+		t.Fatalf("built %v", built)
+	}
+	if remembered.Load() != 1 {
+		t.Fatalf("the transport that works must be remembered once, got %d", remembered.Load())
+	}
+	if connection, err := hop.DialContext(context.Background(), N.NetworkTCP, destination); err != nil {
+		t.Fatalf("the replacement must carry the dial: %v", err)
+	} else {
+		_ = connection.Close()
+	}
+}
+
+func TestATunnelThatCarriedConnectionsLatelyIsNotReplacedBecauseOfOneBadDestination(t *testing.T) {
+	tunnel := &fakeTunnel{name: "wireguard"}
+	hop := newHop(t, []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}, func(candidate) (adapter.Endpoint, error) {
+		t.Error("nothing may be built")
+		return nil, errors.New("unexpected")
+	}, tunnel)
+	hop.lastSuccess = time.Now()
+	destination := M.ParseSocksaddrHostPort("203.0.113.9", 443)
+	for range 5 {
+		_, _ = hop.DialContext(context.Background(), N.NetworkTCP, destination)
+	}
+	time.Sleep(100 * time.Millisecond)
+	if hop.active() != adapter.Endpoint(tunnel) {
+		t.Fatal("the tunnel must stay")
+	}
+}
+
+func TestWhenNoCandidateAnswersTheHopKeepsItsTunnelAndRestsBeforeTrying(t *testing.T) {
+	dead := &fakeTunnel{name: "wireguard"}
+	still := &fakeTunnel{name: "masque"}
+	var builds atomic.Int32
+	hop := newHop(t, []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}, func(candidate) (adapter.Endpoint, error) {
+		builds.Add(1)
+		return still, nil
+	}, dead)
+	destination := M.ParseSocksaddrHostPort("203.0.113.9", 443)
+	_, _ = hop.DialContext(context.Background(), N.NetworkTCP, destination)
+	_, _ = hop.DialContext(context.Background(), N.NetworkTCP, destination)
+	waitFor(t, func() bool {
+		hop.hopAccess.Lock()
+		defer hop.hopAccess.Unlock()
+		return !hop.rotating && builds.Load() > 0
+	})
+	if hop.active() != adapter.Endpoint(dead) {
+		t.Fatal("a failed rotation keeps the current tunnel")
+	}
+	before := builds.Load()
+	_, _ = hop.DialContext(context.Background(), N.NetworkTCP, destination)
+	_, _ = hop.DialContext(context.Background(), N.NetworkTCP, destination)
+	time.Sleep(100 * time.Millisecond)
+	if builds.Load() != before {
+		t.Fatal("the cooldown must stop a second walk right away")
+	}
+}
+
+func TestANetworkChangeForgetsWhatTheOldNetworkTaught(t *testing.T) {
+	hop := newHop(t, []candidate{wireGuardCandidate("198.51.100.1", 2408)}, nil, &fakeTunnel{})
+	hop.demoted = map[transport]bool{transportWireGuard: true}
+	hop.failures = 3
+	hop.coolUntil = time.Now().Add(time.Hour)
+	hop.networkChanged()
+	if len(hop.demoted) != 0 || hop.failures != 0 || !hop.coolUntil.IsZero() {
+		t.Fatalf("state survived the network change: %v %d %v", hop.demoted, hop.failures, hop.coolUntil)
+	}
+}
