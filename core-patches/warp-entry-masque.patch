+func TestACancelBeforeTheSlowLimitSaysNothingAboutTheTunnel(t *testing.T) {
+	hanging := &hangingTunnel{}
+	hop := newHop(t, []candidate{wireGuardCandidate("198.51.100.1", 2408), {transport: transportMasqueQUIC}}, func(candidate) (adapter.Endpoint, error) {
+		t.Error("nothing may be built")
+		return nil, errors.New("unexpected")
+	}, hanging)
