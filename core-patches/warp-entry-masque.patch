index 0000000000000000000000000000000000000000..99911a5e2bc6adeaddda8c5e91fbfee6c465b152
--- /dev/null
+++ b/protocol/warp/transport.go
@@ -0,0 +1,295 @@
+package warp
+
+import (
+	"context"
+	"errors"
+	"net"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/masque"
+	"github.com/sagernet/sing/common/json/badoption"
+	E "github.com/sagernet/sing/common/exceptions"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// transport is how a WARP tunnel reaches Cloudflare. WireGuard is the first choice. MASQUE is Cloudflare's other tunnel
+// (HTTP/3 over QUIC on UDP 443, or HTTP/2 over TLS on TCP 443): it does not look like WireGuard, so it is the way in where a
+// network lets the first WireGuard packets through and then drops the flow (seen on mobile data, 2026-11-26: the handshake
+// was answered once, then every later datagram of the same flow went unanswered) or blocks WireGuard at all.
+type transport uint8
+
+const (
+	transportWireGuard transport = iota
+	transportMasqueQUIC
+	transportMasqueHTTP2
+)
+
+func (t transport) String() string {
+	switch t {
+	case transportMasqueQUIC:
+		return "masque-quic"
+	case transportMasqueHTTP2:
+		return "masque-http2"
+	default:
+		return "wireguard"
+	}
+}
+
+func parseTransport(text string) (transport, bool) {
+	switch strings.TrimSpace(text) {
+	case "masque-quic":
+		return transportMasqueQUIC, true
+	case "masque-http2":
+		return transportMasqueHTTP2, true
+	}
+	return transportWireGuard, false
+}
+
+const (
+	// rotateAfterFailures is how many connections in a row must time out inside the tunnel, with no success between them,
+	// before the tunnel counts as dead and the next candidate takes over. Two, not one: a single destination can be down.
+	rotateAfterFailures = 2
+	// slowDial is how long a connection may wait for the tunnel before it counts as failed. A healthy WARP tunnel opens a
+	// connection in well under a second; the longest legitimate wait (a far server) stays below this.
+	slowDial = 6 * time.Second
+	// quietAfterSuccess protects a working tunnel: a timeout this soon after a success is a bad destination, not a bad tunnel.
+	quietAfterSuccess = 30 * time.Second
+	// rotateCooldown keeps a hop whose every candidate failed from walking the list over and over.
+	rotateCooldown = 30 * time.Second
+	// masqueProbeTimeout, masqueReconnectDelay and masqueHandshakeTimeout bound a MASQUE candidate (see buildMasque).
+	masqueProbeTimeout     = 7 * time.Second
+	masqueReconnectDelay   = 2 * time.Second
+	masqueHandshakeTimeout = 5 * time.Second
+)
+
+// withMasque puts the two MASQUE candidates right after the account's own WireGuard address and its second port: WireGuard
+// stays the first choice (it is the fastest), but a network that blocks it is reached after two failed starts, not after
+// the whole list of alternate edges. An explicit address is the user's choice and gets no MASQUE.
+func withMasque(list []candidate) []candidate {
+	if len(list) < 2 {
+		return list
+	}
+	out := make([]candidate, 0, len(list)+2)
+	out = append(out, list[:2]...)
+	out = append(out, candidate{transport: transportMasqueQUIC}, candidate{transport: transportMasqueHTTP2})
+	return append(out, list[2:]...)
+}
+
+// buildMasque creates the MASQUE tunnel of one candidate. It registers (or reads) its own account, kept next to the
+// WireGuard one, and dials Cloudflare with the same dialer options as the WireGuard endpoint.
+func (w *Endpoint) buildMasque(router adapter.Router, tag string, current candidate) (adapter.Endpoint, error) {
+	profile := w.options.Profile
+	profile.PrivateKey = ""
+	profile.CachePath = masqueAccountPath(w.options.Profile.CachePath)
+	// Its own context: a tunnel that never connects keeps retrying until its context ends, and closing it waits for that.
+	// Cancelling this one (abandon) lets a failed candidate go at once without stopping the whole hop.
+	ctx, cancel := context.WithCancel(w.ctx)
+	built, err := masque.NewOutbound(ctx, router, w.logger, tag, option.MASQUEOutboundOptions{
+		DialerOptions: w.options.DialerOptions,
+		UseHTTP2:      current.transport == transportMasqueHTTP2,
+		Profile:       profile,
+		// Without a delay a network that refuses the socket at once (no route, a firewall) makes the tunnel retry in a
+		// busy loop (500 000 attempts a minute seen on a host with UDP 443 filtered).
+		ReconnectDelay:   badoption.Duration(masqueReconnectDelay),
+		HandshakeTimeout: badoption.Duration(masqueHandshakeTimeout),
+	})
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	tunnel, isEndpoint := built.(adapter.Endpoint)
+	if !isEndpoint {
+		cancel()
+		return nil, E.New("the MASQUE outbound has no lifecycle")
+	}
+	return &masqueTunnel{Endpoint: tunnel, stop: cancel}, nil
+}
+
+// masqueTunnel is a MASQUE tunnel that can be abandoned: its context is cancelled so that closing it does not wait for
+// a connection attempt that will never finish.
+type masqueTunnel struct {
+	adapter.Endpoint
+	stop context.CancelFunc
+}
+
+func (t *masqueTunnel) abandon() { t.stop() }
+
+// discard removes a candidate from the scope; a MASQUE tunnel is abandoned first so that the removal returns at once.
+func (w *Endpoint) discard(scope *adapter.Scope, inner adapter.Endpoint) error {
+	if tunnel, isMasque := inner.(*masqueTunnel); isMasque {
+		tunnel.abandon()
+	}
+	return scope.Remove(inner)
+}
+
+// probeTimeoutFor is how long a candidate gets to carry one connection. MASQUE gets longer: its first start registers an
+// account (two requests to Cloudflare's API) before it can dial.
+func probeTimeoutFor(current candidate) time.Duration {
+	if current.transport != transportWireGuard {
+		return masqueProbeTimeout
+	}
+	return probeTimeout
+}
+
+// masqueAccountPath is where the MASQUE account lives ("" when the WireGuard account has no file).
+func masqueAccountPath(cachePath string) string {
+	if cachePath == "" {
+		return ""
+	}
+	return cachePath + ".masque"
+}
+
+// isTimeout tells a connection that never completed (the tunnel is silent) from one that was refused or reset.
+func isTimeout(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return true
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return true
+	}
+	return strings.Contains(err.Error(), "i/o timeout")
+}
+
+// active is the tunnel connections go through right now (it changes when the hop rotates).
+func (w *Endpoint) active() adapter.Endpoint {
+	w.hopAccess.Lock()
+	defer w.hopAccess.Unlock()
+	return w.endpoint
+}
+
+// watchDial watches one connection through the tunnel and returns the function that reports how it ended. It is
+// event-driven: nothing runs unless the app dials, so the core holds no polling timer for this. A dial that has not
+// completed after slowDial counts as a failure at once (a silent tunnel leaves the caller waiting until its own deadline,
+// and a caller that gives up reports "canceled", which says nothing); a refusal or a cancel before that counts for
+// nothing. Enough failures in a row on a tunnel that carried nothing lately start a rotation.
+func (w *Endpoint) watchDial(inner adapter.Endpoint, network string) func(err error) {
+	if network != N.NetworkTCP {
+		return func(error) {}
+	}
+	var slow atomic.Bool
+	timer := time.AfterFunc(slowDial, func() {
+		slow.Store(true)
+		w.failed(inner)
+	})
+	return func(err error) {
+		timer.Stop()
+		switch {
+		case err == nil:
+			w.succeeded(inner)
+		case !slow.Load() && isTimeout(err):
+			w.failed(inner)
+		}
+	}
+}
+
+func (w *Endpoint) succeeded(inner adapter.Endpoint) {
+	w.hopAccess.Lock()
+	defer w.hopAccess.Unlock()
+	if inner != w.endpoint {
+		return // the answer of a tunnel that was already replaced
+	}
+	w.failures = 0
+	w.lastSuccess = time.Now()
+}
+
+func (w *Endpoint) failed(inner adapter.Endpoint) {
+	w.hopAccess.Lock()
+	defer w.hopAccess.Unlock()
+	if inner != w.endpoint {
+		return
+	}
+	w.failures++
+	if w.failures < rotateAfterFailures || w.rotating || len(w.list) < 2 || w.build == nil {
+		return
+	}
+	if time.Since(w.lastSuccess) < quietAfterSuccess || time.Now().Before(w.coolUntil) {
+		return
+	}
+	w.rotating = true
+	go w.rotate()
+}
+
+// rotate replaces a tunnel that stopped carrying connections: the next candidate is started and must carry one connection
+// before it takes over. The transport that just failed is tried last: a network that cuts WireGuard after its handshake
+// gets MASQUE next, not the same WireGuard on another port.
+func (w *Endpoint) rotate() {
+	w.hopAccess.Lock()
+	failed := w.list[w.position]
+	if w.demoted == nil {
+		w.demoted = map[transport]bool{}
+	}
+	w.demoted[failed.transport] = true
+	order := rotationOrder(w.list, w.position, w.demoted)
+	w.hopAccess.Unlock()
+	w.logger.WarnContext(w.ctx, "WARP tunnel at ", failed.describe(), " stopped carrying connections, moving to the next candidate")
+	for _, index := range order {
+		next := w.list[index]
+		inner, err := w.build(next)
+		if err != nil {
+			w.logger.WarnContext(w.ctx, "WARP candidate ", next.describe(), " did not build: ", err)
+			continue
+		}
+		if err = w.startStages(w.scope, inner); err != nil {
+			_ = w.discard(w.scope, inner)
+			w.logger.WarnContext(w.ctx, "WARP candidate ", next.describe(), " did not start: ", err)
+			continue
+		}
+		if !w.carriesConnection(inner, probeTimeoutFor(next)) {
+			_ = w.discard(w.scope, inner)
+			w.logger.WarnContext(w.ctx, "WARP candidate ", next.describe(), " did not answer")
+			continue
+		}
+		w.hopAccess.Lock()
+		old := w.endpoint
+		w.endpoint, w.position = inner, index
+		w.failures, w.lastSuccess, w.rotating = 0, time.Now(), false
+		w.hopAccess.Unlock()
+		if old != nil {
+			if err = w.discard(w.scope, old); err != nil {
+				w.logger.WarnContext(w.ctx, "closing the replaced WARP tunnel: ", err)
+			}
+		}
+		w.logger.InfoContext(w.ctx, "WARP tunnel answered at ", next.describe(), " after rotation")
+		if w.remember != nil {
+			w.remember(next)
+		}
+		return
+	}
+	w.hopAccess.Lock()
+	w.rotating, w.failures, w.coolUntil = false, 0, time.Now().Add(rotateCooldown)
+	w.hopAccess.Unlock()
+	w.logger.WarnContext(w.ctx, "no WARP candidate answered after rotation, keeping the current tunnel")
+}
+
+// rotationOrder lists the candidate positions to try after position current: the ones whose transport has not failed
+// first, in list order, then the demoted ones (a transport that failed once may work again on another source port).
+func rotationOrder(list []candidate, current int, demoted map[transport]bool) []int {
+	var fresh, rest []int
+	for step := 1; step < len(list); step++ {
+		index := (current + step) % len(list)
+		if demoted[list[index].transport] {
+			rest = append(rest, index)
+		} else {
+			fresh = append(fresh, index)
+		}
+	}
+	return append(fresh, rest...)
+}
+
+// networkChanged forgets what the old network taught: on the new one WireGuard may work, and a failure counted there says
+// nothing about this network.
+func (w *Endpoint) networkChanged() {
+	w.hopAccess.Lock()
+	defer w.hopAccess.Unlock()
+	w.demoted = map[transport]bool{}
+	w.failures = 0
+	w.coolUntil = time.Time{}
+}
