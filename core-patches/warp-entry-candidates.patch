index 0000000000000000000000000000000000000000..5b12fc07f66d2c42b304b6f3125db87f8b4f858f
--- /dev/null
+++ b/protocol/warp/edge_memory.go
@@ -0,0 +1,94 @@
+package warp
+
+import (
+	"net"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+// The edge that answered last is kept next to the account file and tried first at the next start: on a network that blocks
+// the account's own address the walk through alternateEdges then happens once, not at every connect. It is a hint, not a
+// choice: the list is still verified, and a remembered edge that stops answering falls back to the standard order.
+
+// edgeMemoryPath is where the remembered edge lives ("" when there is no account file to sit next to).
+func edgeMemoryPath(cachePath string) string {
+	if cachePath == "" {
+		return ""
+	}
+	return cachePath + ".edge"
+}
+
+// loadEdgeMemory reads "address:port"; anything unreadable or not a literal IP with a port is no memory at all.
+func loadEdgeMemory(path string) (candidate, bool) {
+	if path == "" {
+		return candidate{}, false
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return candidate{}, false
+	}
+	host, portText, err := net.SplitHostPort(strings.TrimSpace(string(content)))
+	if err != nil {
+		return candidate{}, false
+	}
+	if _, err = netip.ParseAddr(host); err != nil {
+		return candidate{}, false
+	}
+	port, err := strconv.ParseUint(portText, 10, 16)
+	if err != nil || port == 0 {
+		return candidate{}, false
+	}
+	return candidate{host, uint16(port)}, true
+}
+
+// saveEdgeMemory keeps the edge atomically with mode 0600; a failure only loses the hint.
+func saveEdgeMemory(path string, edge candidate) error {
+	if path == "" {
+		return nil
+	}
+	temporary, err := os.CreateTemp(filepath.Dir(path), ".warp-edge-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(temporary.Name())
+	if err = temporary.Chmod(0o600); err != nil {
+		temporary.Close()
+		return err
+	}
+	if _, err = temporary.WriteString(net.JoinHostPort(edge.address, strconv.Itoa(int(edge.port))) + "\n"); err != nil {
+		temporary.Close()
+		return err
+	}
+	if err = temporary.Close(); err != nil {
+		return err
+	}
+	return os.Rename(temporary.Name(), path)
+}
+
+// forgetEdge removes the hint (the account's own address answered: nothing to remember).
+func forgetEdge(path string) {
+	if path != "" {
+		_ = os.Remove(path)
+	}
+}
+
+// withRemembered puts the remembered edge first and drops its later duplicate; the rest keep their order.
+func withRemembered(list []candidate, remembered candidate, ok bool) []candidate {
+	if !ok {
+		return list
+	}
+	out := make([]candidate, 0, len(list)+1)
+	out = append(out, remembered)
+	dropped := false
+	for _, c := range list {
+		if c == remembered && !dropped {
+			dropped = true
+			continue
+		}
+		out = append(out, c)
+	}
+	return out
+}
diff --git a/protocol/warp/edge_memory_test.go b/protocol/warp/edge_memory_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..81ffc61a754ba9fa813025fc1943d8ba272e02e5
--- /dev/null
+++ b/protocol/warp/edge_memory_test.go
@@ -0,0 +1,73 @@
+package warp
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"testing"
+)
+
+func TestEdgeMemoryRoundTripIsPrivateAndForgettable(t *testing.T) {
+	path := edgeMemoryPath(filepath.Join(t.TempDir(), "warp-profile.json"))
+	if _, ok := loadEdgeMemory(path); ok {
+		t.Fatal("a missing file is no memory")
+	}
+	want := candidate{"188.114.99.1", 4500}
+	if err := saveEdgeMemory(path, want); err != nil {
+		t.Fatal(err)
+	}
+	got, ok := loadEdgeMemory(path)
+	if !ok || got != want {
+		t.Fatalf("got %v %v, want %v", got, ok, want)
+	}
+	// Windows has no POSIX modes: the account file test skips the same assertion
+	if info, err := os.Stat(path); err != nil || (runtime.GOOS != "windows" && info.Mode().Perm() != 0o600) {
+		t.Fatalf("the hint must be private: %v %v", info, err)
+	}
+	forgetEdge(path)
+	if _, ok := loadEdgeMemory(path); ok {
+		t.Fatal("a forgotten edge is no memory")
+	}
+}
+
+func TestEdgeMemoryRefusesAnythingThatIsNotALiteralAddressWithAPort(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "edge")
+	for _, content := range []string{"", "garbage", "engage.cloudflareclient.com:2408", "188.114.97.1", "188.114.97.1:0", "188.114.97.1:99999"} {
+		if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		if got, ok := loadEdgeMemory(path); ok {
+			t.Fatalf("%q was accepted as %v", content, got)
+		}
+	}
+	if edgeMemoryPath("") != "" {
+		t.Fatal("no account file, no memory file")
+	}
+}
+
+func TestRememberedEdgeGoesFirstWithoutDuplicatesOrLoss(t *testing.T) {
+	list := peerCandidates(accountPeer(), "", 0)
+	remembered := candidate{"188.114.99.1", 4500}
+	got := withRemembered(list, remembered, true)
+	if got[0] != remembered || len(got) != len(list) {
+		t.Fatalf("got %v", got)
+	}
+	count := 0
+	for _, c := range got {
+		if c == remembered {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("the remembered edge appears %d times in %v", count, got)
+	}
+	unknown := candidate{"203.0.113.5", 2408}
+	got = withRemembered(list, unknown, true)
+	if got[0] != unknown || len(got) != len(list)+1 || !reflect.DeepEqual(got[1:], list) {
+		t.Fatalf("got %v", got)
+	}
+	if !reflect.DeepEqual(withRemembered(list, remembered, false), list) {
+		t.Fatal("no memory leaves the list as it is")
+	}
+}
