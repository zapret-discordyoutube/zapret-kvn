index 0000000..47cae1a
--- /dev/null
+++ b/cmd/sing-box/cmd_tools_browser_fetch.go
@@ -0,0 +1,74 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"io"
+	"os"
+	"sync"
+
+	"github.com/sagernet/sing-box/common/browserfetch"
+	"github.com/sagernet/sing-box/log"
+
+	"github.com/spf13/cobra"
+)
+
+var commandBrowserFetchFlagServe bool
+
+// Zapret KVN (Windows): прямые HTTPS-запросы приложения с рукопожатием и
+// HTTP/2 Chrome. Один запрос: JSON на stdin, ответ JSON на stdout. С --serve —
+// долгоживущий процесс с прогретым движком: запросы и ответы — по одной
+// JSON-строке, поле "id" связывает ответ с запросом. Конфиг не нужен.
+var commandBrowserFetch = &cobra.Command{
+	Use:   "browser-fetch",
+	Short: "Fetch HTTPS URLs with the Chromium network stack (JSON on stdin/stdout)",
+	Args:  cobra.NoArgs,
+	Run: func(cmd *cobra.Command, args []string) {
+		// Имена — доверенным DoH тем же движком, не системным DNS.
+		browserfetch.SetResolver(browserfetch.TrustedDoH)
+		if commandBrowserFetchFlagServe {
+			serveBrowserFetch(os.Stdin, os.Stdout)
+			return
+		}
+		request, err := io.ReadAll(io.LimitReader(os.Stdin, 16<<20))
+		if err != nil {
+			log.Fatal(err)
+		}
+		_, err = os.Stdout.WriteString(browserfetch.FetchJSON(globalCtx, string(request)) + "\n")
+		if err != nil {
+			log.Fatal(err)
+		}
+	},
+}
+
+func init() {
+	commandBrowserFetch.Flags().BoolVar(&commandBrowserFetchFlagServe, "serve", false, "serve newline-delimited JSON requests until stdin closes")
+	commandTools.AddCommand(commandBrowserFetch)
+}
+
+func serveBrowserFetch(input io.Reader, output io.Writer) {
+	scanner := bufio.NewScanner(input)
+	scanner.Buffer(make([]byte, 64<<10), 16<<20)
+	var writeLock sync.Mutex
+	var pending sync.WaitGroup
+	for scanner.Scan() {
+		line := append([]byte(nil), scanner.Bytes()...)
+		pending.Add(1)
+		go func() {
+			defer pending.Done()
+			var head struct {
+				ID json.RawMessage `json:"id"`
+			}
+			_ = json.Unmarshal(line, &head)
+			reply := browserfetch.FetchJSON(globalCtx, string(line))
+			if len(head.ID) > 0 {
+				// {"id":…, …ответ…}
+				reply = `{"id":` + string(head.ID) + "," + reply[1:]
+			}
+			writeLock.Lock()
+			_, _ = io.WriteString(output, reply+"\n")
+			writeLock.Unlock()
+		}()
+	}
+	pending.Wait()
+}
diff --git a/common/browserfetch/browserfetch.go b/common/browserfetch/browserfetch.go
new file mode 100644
index 0000000..2561a72
--- /dev/null
+++ b/common/browserfetch/browserfetch.go
@@ -0,0 +1,170 @@
+//go:build with_naive_outbound
+
+// Package browserfetch — HTTPS-клиент, неотличимый от Chrome на проводе.
+//
+// Запрос идёт через сетевой стек самого Chromium (Cronet, тот же, что у
+// naive-выхода): ClientHello, HTTP/2 SETTINGS и WINDOW_UPDATE, порядок
+// псевдозаголовков, сжатие — ровно как у Chrome этой версии. User-Agent
+// берётся из версии движка, чтобы заголовок и рукопожатие не расходились.
+// Zapret KVN ходит так напрямую (DoH, подписка, обновления), чтобы
+// оборудование провайдера не отличало приложение от браузера.
+package browserfetch
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	cronet "github.com/sagernet/cronet-go"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+var (
+	engineMu      sync.Mutex
+	engineStarted bool
+	engine        cronet.Engine
+	// Один исполнитель на всё время жизни движка. RoundTripper без своего
+	// Executor создаёт его на каждый запрос и вешает финализатор, который
+	// уничтожает исполнитель при сборке мусора, — а Chromium ещё досылает в
+	// него request.Destroy() после того, как тело ответа прочитано. Отсюда
+	// SIGSEGV по адресу 0 в случайный момент (Android, стресс-тест на Linux).
+	executor  cronet.Executor
+	agent     string
+	engineErr error
+)
+
+func sharedEngine() (cronet.Engine, string, error) {
+	engineMu.Lock()
+	defer engineMu.Unlock()
+	if !engineStarted {
+		engineStarted = true
+		startEngine()
+	}
+	return engine, agent, engineErr
+}
+
+func startEngine() {
+	// Без libcronet (нет рядом с ядром) загрузчик паникует — это не сбой
+	// сети, а «браузерного стека нет»: вызывающий выберет запасной путь.
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			engineErr = &UnavailableError{Cause: fmt.Sprint(recovered)}
+		}
+	}()
+	engine = cronet.NewEngine()
+	agent = ChromeUserAgent(engine.Version())
+	params := cronet.NewEngineParams()
+	defer params.Destroy()
+	if err := configurePlatform(engine, params); err != nil {
+		engineErr = &UnavailableError{Cause: "configure engine: " + err.Error()}
+		return
+	}
+	params.SetEnableHTTP2(true)
+	// Chrome ходит по QUIC только к узлам, объявившим h3 (Alt-Svc); у
+	// одиночных запросов без кеша Alt-Svc это всегда TCP — как здесь.
+	params.SetEnableQuic(false)
+	params.SetEnableBrotli(true)
+	params.SetUserAgent(agent)
+	if result := engine.StartWithParams(params); result != cronet.ResultSuccess {
+		engineErr = &UnavailableError{Cause: fmt.Sprint("start engine: ", int(result))}
+		return
+	}
+	executor = cronet.NewExecutor(func(_ cronet.Executor, command cronet.Runnable) {
+		go func() {
+			command.Run()
+			command.Destroy()
+		}()
+	})
+}
+
+// UserAgent — User-Agent, с которым уходят запросы (по версии движка).
+func UserAgent() string {
+	_, value, _ := sharedEngine()
+	return value
+}
+
+// Fetch выполняет один запрос. Тело ответа ограничено MaxBytes (по умолчанию 8 МиБ).
+func Fetch(ctx context.Context, request Request) (*Response, error) {
+	target, err := url.Parse(request.URL)
+	if err != nil {
+		return nil, E.Cause(err, "parse url")
+	}
+	if target.Scheme != "https" && !(request.AllowCleartext && target.Scheme == "http") {
+		return nil, E.New("browserfetch: only https is allowed: ", target.Scheme)
+	}
+	method := strings.ToUpper(strings.TrimSpace(request.Method))
+	if method == "" {
+		method = http.MethodGet
+	}
+	// Тело запроса cronet-go отдаёт движку через UploadDataProvider, и этот
+	// путь падает SIGSEGV по адресу 0 (стресс-тест: каждый прогон из сотен POST;
+	// GET — ни одного сбоя на тысячах). Тела не принимаем: DoH — GET с ?dns=,
+	// как у самого Chrome для шаблона dns.google{?dns}.
+	if len(request.Body) > 0 {
+		return nil, E.New("browserfetch: request bodies are not supported (use GET, e.g. DoH ?dns=)")
+	}
+	if request.TimeoutMillis > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, time.Duration(request.TimeoutMillis)*time.Millisecond)
+		defer cancel()
+	}
+	httpRequest, err := http.NewRequestWithContext(ctx, method, target.String(), nil)
+	if err != nil {
+		return nil, err
+	}
+	// User-Agent по умолчанию — Chrome той же версии, что движок; свой UA
+	// вызывающего (профиль клиента подписки) имеет приоритет.
+	for _, header := range request.Headers {
+		httpRequest.Header.Add(header[0], header[1])
+	}
+	shared, _, err := sharedEngine()
+	if err != nil {
+		return nil, err
+	}
+	// С заданными Engine и Executor у RoundTripper нет финализатора: ни движок,
+	// ни исполнитель он не уничтожит.
+	transport := &cronet.RoundTripper{
+		Engine:   shared,
+		Executor: executor,
+		CheckRedirect: func(location string) bool {
+			next, parseErr := url.Parse(location)
+			if parseErr != nil {
+				return false
+			}
+			return next.Scheme == "https" || (request.AllowCleartext && next.Scheme == "http")
+		},
+	}
+	response, err := transport.RoundTrip(httpRequest)
+	if err != nil {
+		return nil, err
+	}
+	defer response.Body.Close()
+	limit := request.MaxBytes
+	if limit <= 0 {
+		limit = DefaultMaxBytes
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	if err != nil {
+		return nil, E.Cause(err, "read body")
+	}
+	result := &Response{Status: response.StatusCode}
+	if int64(len(data)) > limit {
+		data = data[:limit]
+		result.Truncated = true
+	}
+	result.Body = data
+	for name, values := range response.Header {
+		for _, value := range values {
+			result.Headers = append(result.Headers, [2]string{name, value})
+		}
+	}
+	if location := response.Header.Get("Location"); location != "" && response.StatusCode >= 300 && response.StatusCode < 400 {
+		result.RedirectRefused = location
+	}
+	return result, nil
+}
