+package libbox
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/common/browserfetch"
+)
+
+// BrowserFetch — Zapret KVN (Android): один HTTPS-запрос через сетевой стек
+// Chromium, неотличимый от Chrome на проводе. Запрос и ответ — JSON-строки
+// (browserfetch.Request / ответ с полями status, headers, body или error).
+func BrowserFetch(requestJSON string) string {
+	return browserfetch.FetchJSON(context.Background(), requestJSON)
+}
+
+// BrowserUserAgent — User-Agent, с которым уходят такие запросы.
+func BrowserUserAgent() string {
+	return browserfetch.UserAgent()
+}
