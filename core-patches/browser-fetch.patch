+)
+
+// Без сетевого стека Chromium подделывать браузер нечем: лучше честная
+// ошибка, чем запрос с отпечатком Go под видом Chrome.
+func Fetch(context.Context, Request) (*Response, error) {
+	return nil, &UnavailableError{Cause: "built without with_naive_outbound"}
+}
+
+func UserAgent() string { return "" }
+
+// Resolver, SetResolver, TrustedDoH — как в сборке с Chromium; без него
+// запросов нет, резолверу отвечать некому.
