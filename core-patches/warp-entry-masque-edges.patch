+
+// alternateRange names the block an address belongs to ("162.159", "188.114", "2606:4700:d0"): a censor that cut one block
+// of WARP addresses has not necessarily cut the others, so a WireGuard candidate in another block is not a retry of the
+// one that failed (see rotationOrder).
+func alternateRange(address string) string {
+	parsed, err := netip.ParseAddr(address)
+	if err != nil {
+		return address
+	}
+	if parsed.Is4() {
+		octets := parsed.As4()
+		return strconv.Itoa(int(octets[0])) + "." + strconv.Itoa(int(octets[1]))
+	}
+	groups := strings.Split(parsed.StringExpanded(), ":")
+	return strings.Join(groups[:3], ":")
 }
 
