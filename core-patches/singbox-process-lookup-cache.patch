diff --git a/common/process/zapret_pid_table_cache.go b/common/process/zapret_pid_table_cache.go
new file mode 100644
index 0000000000000000000000000000000000000000..96b5b6a62492e9adcf8ef611d914b62a459908ce
--- /dev/null
+++ b/common/process/zapret_pid_table_cache.go
@@ -0,0 +1,163 @@
+package process
+
+// zapret-kvn: Windows connection-owner lookup used to fetch the whole system
+// TCP/UDP table for every new connection and scan it linearly. With tens of
+// thousands of rows and many new connections per second the searcher burned
+// many cores and piled up OS threads. The cache below keeps the raw table for
+// a short time and lets concurrent misses share one fetch. The scan itself is
+// unchanged: rows are matched in table order and the first match wins.
+
+import (
+	"fmt"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+const (
+	// A cached raw table answers hits only while it is this young. It bounds
+	// the window in which a reused ephemeral port could be attributed to the
+	// process that owned it before.
+	pidTableSnapshotTTL = 500 * time.Millisecond
+	// Minimum spacing between two table fetches. Misses arriving meanwhile
+	// wait for the next shared fetch, so a new connection may wait up to this
+	// long for its owner lookup. It caps fetches at 100/s per table when the
+	// table is small; with a large table one fetch already takes longer, so a
+	// longer interval saved no CPU in the win10 A/B (0/10/25/50 ms) and only
+	// added latency.
+	pidTableMinRefreshInterval = 10 * time.Millisecond
+)
+
+// pidRowMatchesTCP is the original winiphlpapi.FindPid predicate for TCP rows.
+func pidRowMatchesTCP(local netip.AddrPort, source netip.AddrPort) bool {
+	return source == local
+}
+
+// pidRowMatchesUDP is the original winiphlpapi.FindPid predicate for UDP rows
+// on Windows: the exact local address, or an unspecified (wildcard) local
+// address bound to the same port.
+func pidRowMatchesUDP(local netip.AddrPort, source netip.AddrPort, unspecified netip.Addr) bool {
+	return source == local || local.Addr() == unspecified && source.Port() == local.Port()
+}
+
+type pidTableFetch[R any] struct {
+	done      chan struct{}
+	startedAt time.Time
+	err       error
+}
+
+type pidTableCache[R any] struct {
+	fetch      func() ([]R, error)
+	match      func(row R, source netip.AddrPort) bool
+	owner      func(row R) uint32
+	now        func() time.Time
+	sleep      func(time.Duration)
+	ttl        time.Duration
+	minRefresh time.Duration
+
+	access    sync.Mutex
+	rows      []R
+	rowsAt    time.Time
+	hasRows   bool
+	inflight  *pidTableFetch[R]
+	lastFetch time.Time
+}
+
+func newPidTableCache[R any](fetch func() ([]R, error), match func(R, netip.AddrPort) bool, owner func(R) uint32) *pidTableCache[R] {
+	return &pidTableCache[R]{
+		fetch:      fetch,
+		match:      match,
+		owner:      owner,
+		now:        time.Now,
+		sleep:      time.Sleep,
+		ttl:        pidTableSnapshotTTL,
+		minRefresh: pidTableMinRefreshInterval,
+	}
+}
+
+func (c *pidTableCache[R]) scan(rows []R, source netip.AddrPort) (uint32, bool) {
+	for _, row := range rows {
+		if c.match(row, source) {
+			return c.owner(row), true
+		}
+	}
+	return 0, false
+}
+
+// find returns the owning pid of source. A miss is never cached: when the
+// available table was fetched before this lookup started, one refreshed table
+// (shared with every concurrent waiter) is scanned again.
+func (c *pidTableCache[R]) find(source netip.AddrPort) (uint32, bool, error) {
+	start := c.now()
+	c.access.Lock()
+	rows, rowsAt, hasRows := c.rows, c.rowsAt, c.hasRows
+	c.access.Unlock()
+	if hasRows && start.Sub(rowsAt) <= c.ttl {
+		if pid, found := c.scan(rows, source); found {
+			return pid, true, nil
+		}
+		if !rowsAt.Before(start) {
+			return 0, false, nil
+		}
+	}
+	rows, err := c.refresh(start)
+	if err != nil {
+		return 0, false, err
+	}
+	pid, found := c.scan(rows, source)
+	return pid, found, nil
+}
+
+func (c *pidTableCache[R]) fetchOnce() (rows []R, err error) {
+	// A panicking fetch must still release the waiters of this refresh.
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			rows, err = nil, fmt.Errorf("process table fetch panic: %v", recovered)
+		}
+	}()
+	return c.fetch()
+}
+
+// refresh returns a table whose fetch began no earlier than start.
+func (c *pidTableCache[R]) refresh(start time.Time) ([]R, error) {
+	c.access.Lock()
+	for {
+		if c.hasRows && !c.rowsAt.Before(start) {
+			rows := c.rows
+			c.access.Unlock()
+			return rows, nil
+		}
+		if call := c.inflight; call != nil {
+			c.access.Unlock()
+			<-call.done
+			if call.err != nil && !call.startedAt.Before(start) {
+				return nil, call.err
+			}
+			c.access.Lock()
+			continue
+		}
+		call := &pidTableFetch[R]{done: make(chan struct{})}
+		c.inflight = call
+		wait := c.minRefresh - c.now().Sub(c.lastFetch)
+		c.access.Unlock()
+		if wait > 0 {
+			c.sleep(wait)
+		}
+		c.access.Lock()
+		call.startedAt = c.now()
+		c.lastFetch = call.startedAt
+		c.access.Unlock()
+		rows, err := c.fetchOnce()
+		c.access.Lock()
+		call.err = err
+		if err == nil {
+			c.rows, c.rowsAt, c.hasRows = rows, call.startedAt, true
+		}
+		c.inflight = nil
+		close(call.done)
+		if err != nil {
+			c.access.Unlock()
+			return nil, err
+		}
+	}
+}
