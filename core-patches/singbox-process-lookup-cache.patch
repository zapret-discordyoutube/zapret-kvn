+// findPid keeps winiphlpapi.FindPid semantics on a briefly cached raw table.
+func (s *windowsSearcher) findPid(network string, source netip.AddrPort) (uint32, error) {
+	var (
+		pid   uint32
+		found bool
+		err   error
+	)
+	switch N.NetworkName(network) {
+	case N.NetworkTCP:
+		if source.Addr().Is4() {
+			pid, found, err = s.tcp4.find(source)
+		} else {
+			pid, found, err = s.tcp6.find(source)
+		}
+	case N.NetworkUDP:
+		if source.Addr().Is4() {
+			pid, found, err = s.udp4.find(source)
+		} else {
+			pid, found, err = s.udp6.find(source)
+		}
+	}
+	if err != nil {
+		return 0, err
+	}
+	if !found {
+		return 0, E.New("process not found for ", source)
+	}
+	return pid, nil
+}
